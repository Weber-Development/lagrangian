{
  "name": "@sweberdev/lagrangian-svelte",
  "version": "0.3.0",
  "description": "Svelte actions and stores for Lagrangian: physical springs, draggable elements with inertia, scroll areas and a 2D physics world.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/lagrangian/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/lagrangian.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/lagrangian/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "svelte",
    "sveltekit",
    "animation",
    "physics",
    "spring",
    "drag",
    "gesture",
    "inertia",
    "gravity",
    "collision"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sweberdev/lagrangian": "workspace:^"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
